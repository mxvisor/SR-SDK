;; The Miles AIL 3.x of a DOS4GW game (runtime/dos/Game_dosail.c): the
;; procedures its external_procedures.sci routes the entry points to, for the
;; game's own llasm to include.  cdecl: arguments on the stack from [esp + 4],
;; the caller pops them, the result in eax.  AIL's own wrappers preserve ebx,
;; esi, edi and ebp; these leave every register but eax untouched.

funcv Game_AIL_startup
funcv Game_AIL_shutdown
func Game_AIL_set_preference number, value
func Game_AIL_register_timer callback
funcv Game_AIL_set_timer_period timer, microseconds
funcv Game_AIL_start_timer timer
funcv Game_AIL_stop_timer timer
funcv Game_AIL_release_timer_handle timer
func Game_AIL_install_DIG_INI *dig
funcp Game_AIL_allocate_sample_handle *dig
funcv Game_AIL_release_sample_handle *S
funcv Game_AIL_init_sample *S
funcv Game_AIL_set_sample_address *S, *start, len
funcv Game_AIL_set_sample_type *S, format, flags
funcv Game_AIL_start_sample *S
funcv Game_AIL_stop_sample *S
funcv Game_AIL_resume_sample *S
funcv Game_AIL_end_sample *S
funcv Game_AIL_set_sample_playback_rate *S, playback_rate
funcv Game_AIL_set_sample_volume *S, volume
funcv Game_AIL_set_sample_pan *S, pan
funcv Game_AIL_set_sample_loop_count *S, loop_count
func Game_AIL_sample_status *S

proc SR_AIL_startup public
    call Game_AIL_startup
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

proc SR_AIL_shutdown public
    call Game_AIL_shutdown
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

proc SR_AIL_set_preference public
    add tmp0, esp, 4
    load tmp0, tmp0, 4
    add tmp1, esp, 2*4
    load tmp1, tmp1, 4
    call Game_AIL_set_preference tmp0, tmp1
    mov eax, tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

proc SR_AIL_register_timer public
    add tmp0, esp, 4
    load tmp0, tmp0, 4
    call Game_AIL_register_timer tmp0
    mov eax, tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

proc SR_AIL_set_timer_period public
    add tmp0, esp, 4
    load tmp0, tmp0, 4
    add tmp1, esp, 2*4
    load tmp1, tmp1, 4
    call Game_AIL_set_timer_period tmp0, tmp1
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

proc SR_AIL_start_timer public
    add tmp0, esp, 4
    load tmp0, tmp0, 4
    call Game_AIL_start_timer tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

proc SR_AIL_stop_timer public
    add tmp0, esp, 4
    load tmp0, tmp0, 4
    call Game_AIL_stop_timer tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

proc SR_AIL_release_timer_handle public
    add tmp0, esp, 4
    load tmp0, tmp0, 4
    call Game_AIL_release_timer_handle tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

