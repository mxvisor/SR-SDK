proc SR_AIL_sample_status public
    add tmp0, esp, 4
    load tmp0, tmp0, 4
    call Game_AIL_sample_status tmp0
    mov eax, tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp
