proc SR_AIL_set_sample_address public
    add tmp0, esp, 4
    load tmp0, tmp0, 4
    add tmp1, esp, 2*4
    load tmp1, tmp1, 4
    add tmp2, esp, 3*4
    load tmp2, tmp2, 4
    call Game_AIL_set_sample_address tmp0, tmp1, tmp2
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

proc SR_AIL_set_sample_type public
    add tmp0, esp, 4
    load tmp0, tmp0, 4
    add tmp1, esp, 2*4
    load tmp1, tmp1, 4
    add tmp2, esp, 3*4
    load tmp2, tmp2, 4
    call Game_AIL_set_sample_type tmp0, tmp1, tmp2
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

