    add tmp0, esp, 4
    load tmp0, tmp0, 4
    add tmp1, esp, 2*4
    load tmp1, tmp1, 4
    call Game_AIL_set_sample_playback_rate tmp0, tmp1
    load tmp0, esp, 4
    add esp, esp, 4
