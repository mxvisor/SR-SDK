include llasm.llinc
include ail2.llinc

; RunProcECX: calls the guest procedure whose address is in ecx.  A guest
; "address of proc" value (e.g. the handler the game hands INT 21h AH=25h) is a
; real, directly callable host address here, and llasm's calling convention
; (fastcc on the single %_cpu* argument) makes a bare indirect tail call
; through a register ABI-correct.
proc RunProcECX global c_RunProcECX

        tcall ecx

endp ; end procedure RunProcECX

; RunProcStack: the same for the address under the return address that
; c_RunProcStack pushes, which it takes off the stack: every register is then
; the callee's (a driver's callback takes its arguments in ecx too).
proc RunProcStack global c_RunProcStack

        POP tmp1
        POP tmp2
        PUSH tmp1
        tcall tmp2

endp ; end procedure RunProcStack

; The default handler for interrupt vectors nothing has registered.
; WATCOM/DOS4GW startup code (like the game's own INT 08h handler) commonly
; chains to "the previously installed handler" by overwriting its own return
; frame with the saved old vector and executing retf/iret into it -- real DOS
; always has *some* handler there (the BIOS's own default), never a null
; pointer.  Game_DosRuntimeInit seeds the vectors with this stub's address, so
; that chain lands somewhere safe: it returns at once, popping the iretd frame
; (eip, cs, eflags) the way SR translates `iretd`.  An ISR must leave every
; guest register exactly as it found it, so the return address goes in a
; scratch temp, not in eax.  Game_DosNullIsrReached tells the runtime that
; the chain got here: a hardware interrupt then goes on to the real-mode
; handler of its vector, as DOS/4GW passes it on (Game_DosHardwareInterrupt).
funcv Game_DosNullIsrReached

proc Game_DosNullIsr global c_Game_DosNullIsr

        call Game_DosNullIsrReached
        POP tmp1
        add esp, esp, 4
        POPFD
        tcall tmp1

endp ; end procedure Game_DosNullIsr
