;; The drivers of the Miles AIL/32 2.x of a DOS4GW game (runtime/dos/Game_dosail2.c):
;; the two procedures its external_procedures.sci routes AIL_register_driver and
;; the dispatcher of the driver functions to.  Both leave every register but eax
;; untouched.

func Game_AIL2_RegisterDriver image
func Game_AIL2_CallDriver function, arguments

; AIL_register_driver(driver): cdecl, the handle (-1: none) in eax
proc SR_AIL2_register_driver public
    add tmp0, esp, 4
    load tmp0, tmp0, 4
    call Game_AIL2_RegisterDriver tmp0
    mov eax, tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp

; The dispatcher: the number of the driver function in eax, the stack as the
; API function's caller left it (its return address, the driver's handle, the
; other arguments); the result in eax
proc SR_AIL2_call_driver public
    mov tmp0, eax
    add tmp1, esp, 4
    call Game_AIL2_CallDriver tmp0, tmp1
    mov eax, tmp0
    load tmp0, esp, 4
    add esp, esp, 4
    tcall tmp0
endp
